aws_region              = "us-east-1"

# checks for profile in ~/.aws/credentials
aws_profile             = ""

project_name            = ""
resourceOwner           = "<owner name>"
ownerEmail              = ""
instance_size           = "m5.2xlarge"

vpc_name                = ""
vpc_cidr                = "10.245.0.0/16"
mgmt_subnet_name        = "mgmt"
mgmt_cidr               = "10.245.1.0/24"
external_subnet_name    = "external"
external_cidr           = "10.245.10.0/24"
internal_subnet_name    = "internal"
internal_cidr           = "10.245.20.0/24"
availability_zone       = "us-east-1a"

external_gw             = "10.245.10.1"

vm_name                 = ""
instance_prefix         = "

vpnMgmtSrcAddr          = ["104.219.104.0/21"]
REtrafficSrcAddr        = ["5.182.212.0/22", "23.158.32.0/24", "84.54.60.0/22", "103.135.56.0/22", "159.60.160.0/19", "185.56.154.0/24", "185.94.142.0/23"]

bigip-hostname          = ""
ssh_publickey           = "~/.ssh/id_rsa.pub"

f5_ami_search_name      = "*BIGIP-21.1*BYOL*"
f5_ami_owner            = "aws-marketplace"

f5_username             = ""
f5_username_2           = ""
f5_password             = ""
# f5_password used for both users for simplicity

dns_suffix              = ""
dns_server              = "8.8.8.8"
ntp_server              = "0.us.pool.ntp.org"
timezone                = "US/Pacific"
script_name             = "f5_onboard"

INIT_URL                = "https://github.com/F5Networks/f5-bigip-runtime-init/releases/download/2.0.3/f5-bigip-runtime-init-2.0.3-1.gz.run"

# F5 BYOL registration key. Replace with your actual key.
byol_license            = "XXXXX-XXXXX-XXXXX-XXXXX-XXXXXXX"
