# ---------------------------------------------------------------------------
# Download DO and AS3 RPMs from S3
#
# BIG-IP VE has python3 but not awscli or boto3. This inline script uses
# only stdlib to get IMDSv2 credentials and make SigV4-signed S3 GETs.
# ---------------------------------------------------------------------------

cat << 'PYEOF' > /config/cloud/s3_download.py
import sys, os, json, hashlib, hmac, datetime
from urllib.request import Request, urlopen

def get_imdsv2_token():
    req = Request("http://169.254.169.254/latest/api/token", method="PUT")
    req.add_header("X-aws-ec2-metadata-token-ttl-seconds", "300")
    with urlopen(req, timeout=5) as resp:
        return resp.read().decode()

def get_iam_credentials(token):
    hdr = {"X-aws-ec2-metadata-token": token}
    base = "http://169.254.169.254/latest/meta-data/iam/security-credentials/"
    with urlopen(Request(base, headers=hdr), timeout=5) as resp:
        role = resp.read().decode().strip()
    with urlopen(Request(base + role, headers=hdr), timeout=5) as resp:
        return json.loads(resp.read().decode())

def _sign(key, msg):
    return hmac.new(key, msg.encode("utf-8"), hashlib.sha256).digest()

def _signing_key(secret, date_stamp, region, service):
    k = _sign(("AWS4" + secret).encode("utf-8"), date_stamp)
    k = _sign(k, region)
    k = _sign(k, service)
    return _sign(k, "aws4_request")

def download(bucket, key, region, output_path):
    token = get_imdsv2_token()
    creds = get_iam_credentials(token)
    access_key    = creds["AccessKeyId"]
    secret_key    = creds["SecretAccessKey"]
    session_token = creds["Token"]

    host = "{}.s3.{}.amazonaws.com".format(bucket, region)
    uri  = "/{}".format(key)
    now  = datetime.datetime.utcnow()
    amz_date   = now.strftime("%Y%m%dT%H%M%SZ")
    date_stamp = now.strftime("%Y%m%d")
    payload_hash = hashlib.sha256(b"").hexdigest()

    canonical_headers = (
        "host:{}\n"
        "x-amz-content-sha256:{}\n"
        "x-amz-date:{}\n"
        "x-amz-security-token:{}\n"
    ).format(host, payload_hash, amz_date, session_token)
    signed_headers = "host;x-amz-content-sha256;x-amz-date;x-amz-security-token"

    canonical_request = "\n".join([
        "GET", uri, "",
        canonical_headers,
        signed_headers,
        payload_hash,
    ])

    credential_scope = "/".join([date_stamp, region, "s3", "aws4_request"])
    string_to_sign = "\n".join([
        "AWS4-HMAC-SHA256",
        amz_date,
        credential_scope,
        hashlib.sha256(canonical_request.encode("utf-8")).hexdigest(),
    ])

    sig_key   = _signing_key(secret_key, date_stamp, region, "s3")
    signature = hmac.new(sig_key, string_to_sign.encode("utf-8"),
                         hashlib.sha256).hexdigest()

    authorization = (
        "AWS4-HMAC-SHA256 Credential={}/{}, "
        "SignedHeaders={}, Signature={}"
    ).format(access_key, credential_scope, signed_headers, signature)

    url = "https://{}{}".format(host, uri)
    req = Request(url)
    req.add_header("Authorization", authorization)
    req.add_header("x-amz-date", amz_date)
    req.add_header("x-amz-content-sha256", payload_hash)
    req.add_header("x-amz-security-token", session_token)
    req.add_header("Host", host)

    with urlopen(req, timeout=120) as resp, open(output_path, "wb") as f:
        while True:
            chunk = resp.read(65536)
            if not chunk:
                break
            f.write(chunk)

    size = os.path.getsize(output_path)
    print("OK  s3://{}/{} -> {} ({} bytes)".format(bucket, key, output_path, size))

if __name__ == "__main__":
    download(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4])
PYEOF

# Download Declarative Onboarding RPM from S3
for i in {1..30}; do
    python3 /config/cloud/s3_download.py "${rpm_bucket}" "${do_rpm_key}" "${aws_region}" "/var/config/rest/downloads/${do_rpm_key}" && break || sleep 10
done

# Download AS3 RPM from S3
for i in {1..30}; do
    python3 /config/cloud/s3_download.py "${rpm_bucket}" "${as3_rpm_key}" "${aws_region}" "/var/config/rest/downloads/${as3_rpm_key}" && break || sleep 10
done

# Download BIG-IP Runtime Init
for i in {1..30}; do
    curl -fv --retry 1 --connect-timeout 5 -L ${INIT_URL} -o "/var/config/rest/downloads/f5-bigip-runtime.gz.run" && break || sleep 10
done

# Install BIG-IP Runtime Init
bash /var/config/rest/downloads/f5-bigip-runtime.gz.run -- '--cloud aws'

# Run BIG-IP Runtime Init and Process YAML
f5-bigip-runtime-init --config-file /config/cloud/runtime-init-conf.yaml