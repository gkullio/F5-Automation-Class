# Azure Credentials
# For the providers.tf in the root
# Azure Service Principal Information
# --Retreive from Azure Portal or CLI--
# --Recommend using a custom role with Contributor + role assignment permissions--
# Azure CLI Example: az ad sp create-for-rbac --name <name> --role <your custom role name> --scopes /subscriptions/<your Azure subscription ID>
client_id       = ""
client_secret   = ""
tenant_id       = ""
subscription_id = ""

# Global Variables
# Resource group information for the deployment of the BIG-IP VE
# Use your business email or name for the resourceOwner to track / audit your deployment in Azure
# https://clouddocs.f5.com/cloud/public/v1/matrix.html#microsoft-azure
# ***Recommended*** to use Standard_D8s_v5 for the BIG-IP VE
rg_name         = ""
resourceOwner   = ""
location        = ""
instance_size   = "Standard_D8s_v5"


####### Module azure_vnet #######

# Virtual Network information for the deployment of the BIG-IP VE
vnet_name           = ""
vnet_address_space  = "10.245.0.0/16"
mgmt_subnet_name    = "mgmt"
mgmt_address_space  = "10.245.1.0/24"
ext_subnet_name     = "ext"
ext_address_space   = "10.245.2.0/24"
int_subnet_name     = "int"
int_address_space   = "10.245.3.0/24"

####### Module BIG-IP VM #######

vm_name             = "bigip-poc"
instance_prefix     = "bigip-poc-1"
bigip-username      = "testuser"
bigip-password      = "T3stP@ssw0rd"

####### Networking source address lists  #######

# Restrict Source IP Access Source address to your IP address or range of IP addresses
# ***Recommended*** Use an array here
# ["x.x.x.x/32"] for a single IP
# ["x.x.x.x/32", "y.y.y.y/32", "z.z.z.z"] to allow multiple IP addresses

vpnMgmtSrcAddr              = ["1.6.70.48/28", "4.18.241.192/26", "42.61.112.48/28", "50.236.107.0/28", "50.237.173.32/29", "62.90.170.80/28", "84.108.132.208/28", "104.219.104.0/21", "106.38.0.192/29", "106.38.20.192/28", "115.110.154.64/28", "162.220.44.16/28", "172.85.45.72/29", "189.201.174.80/29", "189.201.174.96/28", "201.168.196.176/28", "201.168.199.104/29", "203.47.24.240/28", "209.189.196.192/26", "210.226.41.192/27"]
REtrafficSrcAddr            = ["5.182.212.0/25", "5.182.213.0/24", "5.182.214.0/25", "5.182.215.0/25", "23.158.32.0/25", "84.54.60.0/25", "84.54.61.0/25", "84.54.62.0/25", "103.135.56.0/24", "103.135.57.0/25", "103.135.58.0/24", "103.135.59.0/25", "159.60.160.0/22", "159.60.164.0/24", "159.60.166.0/24", "159.60.168.0/24", "159.60.170.0/24", "159.60.172.0/24", "159.60.174.0/23", "159.60.176.0/21", "159.60.184.0/23", "159.60.186.0/24", "159.60.188.0/22", "185.56.154.0/25", "185.94.142.0/24", "185.94.143.0/25"]


# BIG-IP VE specific variables for onboarding script

bigip-hostname      = "bigip-poc"
ssh_publickey       = "~/.ssh/id_rsa.pub"
f5_product_name     = "f5-big-ip-byol"
f5_image_name       = "f5-big-all-2slot-byol"
f5_version          = "17.5.109174"
license_key         = ""

# Please create two users.
# ***root account is locked out by default in the BIG-IP VE***

f5_username         = "user1"
f5_username_2       = "user2"

# Same password used for both users for the PoC
f5_password         = "T3stP@ssw0rd"
dns_suffix          = "pov.byol"
dns_server          = "8.8.8.8"
availability_zone   = 1
ntp_server          = "0.us.pool.ntp.org"
timezone            = "US/Pacific"
script_name         = "f5_onboard"
enable_ssh_key      = false
INIT_URL            = "https://github.com/F5Networks/f5-bigip-runtime-init/releases/download/2.0.1/f5-bigip-runtime-init-2.0.1-1.gz.run"
