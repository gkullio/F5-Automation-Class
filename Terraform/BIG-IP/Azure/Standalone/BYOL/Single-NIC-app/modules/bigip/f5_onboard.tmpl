# ---------------------------------------------------------------------------
# Download DO and AS3 RPMs from Azure Blob Storage
#
# BIG-IP VE has python3 but not az cli. This inline script uses only stdlib
# to get a managed-identity token from Azure IMDS and download blobs via
# the Azure Storage REST API.
# ---------------------------------------------------------------------------

cat << 'PYEOF' > /config/cloud/blob_download.py
import sys, os, json
from urllib.request import Request, urlopen

def get_managed_identity_token():
    url = ("http://169.254.169.254/metadata/identity/oauth2/token"
           "?api-version=2018-02-01"
           "&resource=https://storage.azure.com/")
    req = Request(url)
    req.add_header("Metadata", "true")
    with urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode())["access_token"]

def download(storage_account, container, blob_name, output_path):
    token = get_managed_identity_token()
    url = "https://{}.blob.core.windows.net/{}/{}".format(
        storage_account, container, blob_name)
    req = Request(url)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("x-ms-version", "2020-10-02")
    with urlopen(req, timeout=120) as resp, open(output_path, "wb") as f:
        while True:
            chunk = resp.read(65536)
            if not chunk:
                break
            f.write(chunk)
    size = os.path.getsize(output_path)
    print("OK  {}/{}/{} -> {} ({} bytes)".format(
        storage_account, container, blob_name, output_path, size))

if __name__ == "__main__":
    download(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4])
PYEOF

# Download Declarative Onboarding RPM from Azure Blob Storage
for i in {1..30}; do
    python3 /config/cloud/blob_download.py "${rpm_storage_account}" "${rpm_container}" "${do_rpm_key}" "/var/config/rest/downloads/${do_rpm_key}" && break || sleep 10
done

# Download AS3 RPM from Azure Blob Storage
for i in {1..30}; do
    python3 /config/cloud/blob_download.py "${rpm_storage_account}" "${rpm_container}" "${as3_rpm_key}" "/var/config/rest/downloads/${as3_rpm_key}" && break || sleep 10
done

# Download BIG-IP Runtime Init
for i in {1..30}; do
    curl -fv --retry 1 --connect-timeout 5 -L ${INIT_URL} -o "/var/config/rest/downloads/f5-bigip-runtime.gz.run" && break || sleep 10
done

# Remove comment to do silly debugging on BIG-IP Runtime init
# export F5_BIGIP_RUNTIME_INIT_LOG_LEVEL=silly
# export F5_BIGIP_RUNTIME_EXTENSION_INSTALL_DELAY_IN_MS=60000

# Install BIG-IP Runtime Init
bash /var/config/rest/downloads/f5-bigip-runtime.gz.run -- '--cloud azure'

