# ---------------------------------------------------------------------------
# Download DO, AS3, and CFE RPMs from GCS
# ---------------------------------------------------------------------------

cat << 'PYEOF' > /config/cloud/gcs_download.py
import sys, os, json
from urllib.request import Request, urlopen
from urllib.parse import quote

def get_access_token():
    url = "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token"
    req = Request(url)
    req.add_header("Metadata-Flavor", "Google")
    with urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode())["access_token"]

def download(bucket, key, output_path):
    token = get_access_token()
    encoded_key = quote(key, safe="")
    url = "https://storage.googleapis.com/storage/v1/b/{}/o/{}?alt=media".format(bucket, encoded_key)
    req = Request(url)
    req.add_header("Authorization", "Bearer {}".format(token))

    with urlopen(req, timeout=120) as resp, open(output_path, "wb") as f:
        while True:
            chunk = resp.read(65536)
            if not chunk:
                break
            f.write(chunk)

    size = os.path.getsize(output_path)
    print("OK  gs://{}/{} -> {} ({} bytes)".format(bucket, key, output_path, size))

if __name__ == "__main__":
    download(sys.argv[1], sys.argv[2], sys.argv[3])
PYEOF

sleep 100

# Download Declarative Onboarding RPM from GCS
for i in {1..30}; do
    python3 /config/cloud/gcs_download.py "${rpm_bucket}" "${do_rpm_key}" "/var/config/rest/downloads/${do_rpm_key}" && break || sleep 10
done

# Download AS3 RPM from GCS
for i in {1..30}; do
    python3 /config/cloud/gcs_download.py "${rpm_bucket}" "${as3_rpm_key}" "/var/config/rest/downloads/${as3_rpm_key}" && break || sleep 10
done

# Download Cloud Failover Extension RPM from GCS
for i in {1..30}; do
    python3 /config/cloud/gcs_download.py "${rpm_bucket}" "${cfe_rpm_key}" "/var/config/rest/downloads/${cfe_rpm_key}" && break || sleep 10
done

# Download BIG-IP Runtime Init
for i in {1..30}; do
    curl -fv --retry 1 --connect-timeout 5 -L ${INIT_URL} -o "/var/config/rest/downloads/f5-bigip-runtime.gz.run" && break || sleep 10
done

# Install BIG-IP Runtime Init
bash /var/config/rest/downloads/f5-bigip-runtime.gz.run -- '--cloud gcp'

# Run BIG-IP Runtime Init and Process YAML
/usr/local/bin/f5-bigip-runtime-init --config-file /config/cloud/runtime-init-conf.yaml
