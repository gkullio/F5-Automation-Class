# IP addresses contain F5 VPN, RE, and DNSLB addresses
# This is an array and can be added to as needed
# add your own IP within the quotes and separated by a comma
# ipv4.icanhazip.com can be used to find your public IP address
adminSrcAddr        = [""]

# GCP Project & Region
gcp_region          = "us-west1"
gcp_zone            = "us-west1-a"

# GCP Credentials (optional - leave commented to use Application Default Credentials via gcloud auth)
# gcp_credentials_file = "path/to/service-account-key.json"

# Network
mgmt_subnet_cidr    = "10.245.1.0/24"
int_subnet_cidr     = "10.245.2.0/24"
# Keep this IP scheme or you will need to change the values within the nginx.tpl and config/demoapp.conf files

# VM
machine_type        = "e2-medium"
hostname            = ""
resourceOwner       = ""  # Email address
username            = ""

# Instance NGINX Data Plane Token
dp_token            = ""
