# IP addresses contain F5 VPN, RE, and DNSLB addresses
# This is an array and can be added to as needed
# add your own IP within the quotes and separated by a comma
# ipv4.icanhazip.com can be used to find your public IP address
adminSrcAddr                = [""]
instance_size               = "Standard_DC1s_v2"
hostname                    = ""
resourceOwner               = ""   # Email address
username                    = ""
password                    = ""
vnet_name                   = ""
vnet_address_space          = "10.245.0.0/16"   
mgmt_subnet_name            = "mgmt"
mgmt_address_space          = "10.245.1.0/24"
int_subnet_name             = "int"
int_address_space           = "10.245.2.0/24"

# Resource Group Information
resource_group_location     = "westus2"
resource_group_name_prefix  = ""

# Instance NGINX Data Plane Token
dp_token                    = ""

# Let's Encrypt Email Variable
# This is needed for Let's Encrypt to create a certificate.
le_email = "<valid email address>"

# main.tf Azure Service Principal Information
# --Retreive from Azure Portal or CLI--
# --Recommend using the Contributor role for the Service Principal--
# Azure CLI Example: az ad sp create-for-rbac --name <name> --role Contributor --scopes /subscriptions/<your Azure subscription ID>

# Azure Credentials
client_id       = ""
client_secret   = ""
tenant_id       = ""
subscription_id = ""