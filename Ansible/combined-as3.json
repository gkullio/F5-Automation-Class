{
    "class": "AS3",
    "action": "deploy",
    "persist": true,
    "declaration": {
        "class": "ADC",
        "schemaVersion": "3.57.0",
        "remark": "A HTTP sample application",
        "demo_app": {
            "class": "Tenant",
            "demo_app": {
                "class": "Application",
                "demo_app_vs": {
                    "class": "Service_HTTPS",
                    "virtualAddresses": [
                        "10.245.2.5"
                    ],
                    "virtualPort": 443,
                    "shareAddresses": true,
                    "iRules": [
                        "rule_client_xff"
                    ],
                    "profileHTTP": {
                        "use": "http_xff"
                    },
                    "serverTLS": {
                        "bigip": "/Common/Shared/letsencrypt_tls"
                    },
                    "pool": "demo_app_http_pool"
                },
                "rule_client_xff": {
                    "class": "iRule",
                    "iRule": "when HTTP_REQUEST { HTTP::header insert X-Forwarded-For [IP::remote_addr] }"
                },
                "http_xff": {
                    "class": "HTTP_Profile",
                    "xForwardedFor": true
                },
                "demo_app_http_pool": {
                    "class": "Pool",
                    "monitors": [
                        "http"
                    ],
                    "members": [
                        {
                            "servicePort": 80,
                            "serverAddresses": [
                                "10.245.3.100"
                            ]
                        }
                    ]
                }
            }
        },
        "juice_shop_app": {
