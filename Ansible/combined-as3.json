            "dvwa_app": {
                "class": "Application",
                "dvwa_app_vs": {
                    "class": "Service_HTTPS",
                    "virtualAddresses": [
                        "10.245.2.7"
                    ],
                    "virtualPort": 443,
                    "shareAddresses": true,
                    "iRules": [
                        "rule_client_xff"
