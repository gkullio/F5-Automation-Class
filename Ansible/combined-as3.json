{
    "class": "AS3",
    "action": "deploy",
    "persist": true,
    "declaration": {
        "class": "ADC",
        "schemaVersion": "3.0.0",
        "label": "Sample 1",
        "remark": "A HTTP sample application",
        "Demo_Application": {
            "class": "Tenant",
            "demo_https_app": {
                "class": "Application",
                "demo_app_https_vs": {
                    "class": "Service_HTTPS",
                    "virtualAddresses": [
                        "10.245.1.4"
                    ],
                    "virtualPort": 443,
                    "shareAddresses": true,
                    "iRules": [
                        "rule_client_xff_replace_host"
                    ],
                    "profileHTTP": {
                        "use": "http_xff"
                    },
                    "clientTLS": {
                        "bigip": "/Common/serverssl"
                    },
                    "serverTLS": {
                        "bigip": "/Common/Shared/letsencrypt_tls"
                    },
                    "pool": "demo_app_http_pool"
                },
                "rule_client_xff_replace_host": {
                    "class": "iRule",
                    "iRule": "when HTTP_REQUEST { HTTP::header replace Host \"demo-app-kulland-232.azurewebsites.net\" }"
                },
                "http_xff": {
                    "class": "HTTP_Profile",
                    "xForwardedFor": true
                },
                "demo_app_http_pool": {
                    "class": "Pool",
                    "monitors": [
                        "https"
                    ],
                    "members": [
                        {
                            "servicePort": 443,
                            "serverAddresses": [
                                "10.245.1.5"
                            ]
                        }
                    ]
                }
            }
        }
    }
}