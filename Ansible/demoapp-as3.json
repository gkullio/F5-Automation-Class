{
         "class": "AS3",
            "action": "deploy",
            "persist": true,
            "declaration": {
                "class": "ADC",
                "schemaVersion": "3.0.0",
                "label": "Test 1",
                "remark": "Test Demoapp deployment",
                "Demo_Application": {
                    "class": "Tenant",
                    "demoapp-ansible": {
                        "class": "Application",
                        "demo_app_https_vs": {
                            "class": "Service_HTTPS",
                            "virtualAddresses": [ "" ],
                            "virtualPort": 443,
                            "shareAddresses": true,
                            "iRules": [
                                "rule_client_xff_replace_host"
                            ],
                            "profileHTTP": {
                                "use": "http_xff"
                            },
                            "serverTLS": {
                                "bigip": "/Common/clientssl"
                            },
                            "pool": "demo_app_http_pool"
                        },
                        "rule_client_xff_replace_host": {
                            "class": "iRule",
                            "iRule": "when HTTP_REQUEST { HTTP::header replace Host \"\" }"
                        },
                        "http_xff": {
                            "class": "HTTP_Profile",
                            "xForwardedFor": true
                        },
                        "demo_app_http_pool": {
                            "class": "Pool",
                            "monitors": [
                                "http"
                            ],
                            "members": [
                                {
                                    "servicePort": 80,
                                    "serverAddresses": [
                                        ""
                                    ]
                                }
                            ]
                        }
                    }
                }
            }
        }